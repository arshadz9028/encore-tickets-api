generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HoldStatus {
  active
  expired
  converted
}

enum OrderStatus {
  paid
  refunded
  partially_refunded
}

model Event {
  id        String   @id
  title     String
  venue     String
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tiers Tier[]

  @@map("events")
}

model Tier {
  id             String   @id
  eventId        String   @map("event_id")
  name           String
  price          Int
  currency       String   @db.VarChar(3)
  totalInventory Int      @map("total_inventory")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  holds  Hold[]
  orders Order[]

  @@index([eventId])
  @@map("tiers")
}

model Hold {
  id        String     @id @default(cuid())
  tierId    String     @map("tier_id")
  quantity  Int
  expiresAt DateTime   @map("expires_at") @db.Timestamptz(3)
  status    HoldStatus @default(active)
  orderId   String?    @unique @map("order_id")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  tier Tier @relation(fields: [tierId], references: [id], onDelete: Restrict)

  @@index([tierId, status, expiresAt])
  @@map("holds")
}

model Order {
  // External processor order ID is the source of truth.
  id             String      @id
  tierId         String?     @map("tier_id")
  quantity       Int?
  status         OrderStatus
  amountTotal    Int?        @map("amount_total")
  amountRefunded Int         @default(0) @map("amount_refunded")
  currency       String?     @db.VarChar(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tier Tier? @relation(fields: [tierId], references: [id], onDelete: Restrict)

  @@index([tierId, status])
  @@map("orders")
}

model WebhookEvent {
  id          String    @id
  eventType   String    @map("event_type")
  payload     Json
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([processedAt])
  @@map("webhook_events")
}
